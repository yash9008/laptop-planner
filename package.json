{
  "name": "laptop-planner",
  "productName": "Laptop Planner",
  "version": "0.1.0",
  "description": "An offline personal planner for one Mac.",
  "private": true,
  "type": "module",
  "main": "out/main/index.cjs",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "postinstall": "install-electron && node scripts/verify-native.mjs",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "npm start",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run test:scheduler && npm run test:db && npm run test:app",
    "test:scheduler": "node scripts/test-scheduler.mjs",
    "demo:scheduler": "node scripts/demo-scheduler.mjs",
    "test:db": "node scripts/test-database.mjs",
    "test:app": "playwright test",
    "check": "npm run typecheck && npm test",
    "package:mac": "npm run build && electron-builder --mac dmg --arm64 --publish never",
    "verify:package": "node scripts/verify-packaged.mjs"
  },
  "build": {
    "appId": "local.laptop-planner.desktop",
    "productName": "Laptop Planner",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/better-sqlite3/prebuilds/linux*.node",
      "!node_modules/better-sqlite3/prebuilds/win32*.node",
      "!node_modules/better-sqlite3/prebuilds/darwin-x64.node"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": true,
      "artifactName": "Laptop-Planner-${version}-${arch}.${ext}",
      "icon": "build-assets/LaptopPlanner.icns"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3": false,
    "electron-winstaller": false,
    "fsevents": false
  }
}
